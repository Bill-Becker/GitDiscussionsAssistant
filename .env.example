# Copy to .env and fill in. Never commit .env.
GITHUB_WEBHOOK_SECRET=change-me
OPENAI_API_KEY=sk-...
# Leave unset for api.openai.com; NLR keys use https://litellm.nlr.gov (NLR network only)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
SENDGRID_API_KEY=SG....
FROM_EMAIL=reopt-notify@nlr.gov
REOPT_EMAIL=REopt@nlr.gov
# Base URL hosting nrel_root.pem and nrel_xca1.pem (only needed on NLR's network)
NREL_ROOT_CERT_URL_ROOT=
# Comma-separated GitHub logins whose posts are ignored (bots are always ignored)
TEAM_USERNAMES=nlr-bot,another-account
